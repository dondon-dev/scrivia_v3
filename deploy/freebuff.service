# ═══════════════════════════════════════════════════════════════════════════
# Freebuff Desktop — PocketBase + Litestream Systemd Service
# ═══════════════════════════════════════════════════════════════════════════
# Install:
#   sudo cp freebuff.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now freebuff
# ═══════════════════════════════════════════════════════════════════════════

[Unit]
Description=Freebuff Desktop — PocketBase Backend + Litestream Backup
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=freebuff
Group=freebuff
WorkingDirectory=/opt/freebuff

# ── Environment ──────────────────────────────────────────────────────────
EnvironmentFile=/opt/freebuff/.env

# ── PocketBase ───────────────────────────────────────────────────────────
ExecStartPre=/opt/freebuff/litestream replicate \
  -config /opt/freebuff/litestream/litestream.yml \
  -sync-interval 1s &
ExecStart=/opt/freebuff/pocketbase serve \
  --http=0.0.0.0:8090 \
  --dir=/var/lib/freebuff/data \
  --publicDir=/opt/freebuff/frontend/dist
ExecReload=/bin/kill -HUP $MAINPID

# ── Restart policy ───────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=300

# ── Security hardening ──────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/freebuff
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# ── Resource limits ─────────────────────────────────────────────────────
LimitNOFILE=65536
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
