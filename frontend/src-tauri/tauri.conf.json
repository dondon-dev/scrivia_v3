{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Scrivia Payroll",
  "version": "2.0.0",
  "identifier": "com.freebuff.scrivia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scrivia Payroll — Smart Payroll. Secure Future.",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://scriviapayroll.com/; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://*.r2.cloudflarestorage.com https://api.scriviapayroll.com https://scriviapayroll.com/ http://127.0.0.1:8090"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "scope": ["$APPDATA/**", "$HOME/**"]
    },
    "http": {
      "scope": ["https://api.scriviapayroll.com/**", "https://*.r2.cloudflarestorage.com/**", "http://127.0.0.1:8090/**"]
    }
  }
}