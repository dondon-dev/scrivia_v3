# ═══════════════════════════════════════════════════════════════════════════
# Freebuff Desktop — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════

# ── PocketBase ───────────────────────────────────────────────────────────────
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@freebuff.local
POCKETBASE_ADMIN_PASSWORD=changeme-strong-password

# ── Cloudflare R2 (Litestream backup target) ─────────────────────────────────
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=scrivia-backups
R2_ACCOUNT_ID=your-cloudflare-account-id

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Scrivia Cloud
APP_VERSION=2.0.0
APP_PORT=8090

# ── Vite (frontend build) ────────────────────────────────────────────────────
# Only needed during development — in production, PocketBase serves the built
# frontend from its publicDir.
VITE_POCKETBASE_URL=http://localhost:8090
