# ═══════════════════════════════════════════════════════════════════════════
# Freebuff Desktop — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════

# ── PocketBase server (the local process itself — NOT used by the browser) ──
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@freebuff.local
POCKETBASE_ADMIN_PASSWORD=Darkangel661994#

# ── Cloudflare R2 (Litestream backup target) ─────────────────────────────────
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=scrivia-backups
R2_ACCOUNT_ID=your-cloudflare-account-id

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Scrivia Cloud
APP_VERSION=2.0.0
APP_PORT=8090

# ── Vite (frontend build) ────────────────────────────────────────────────────
# The frontend PocketBase API base URL. Vite picks the file per mode:
#   .env.local      → used by `npm run dev`            (local PocketBase)
#   .env.production → used by `npm run build`          (deployed PocketBase)
#
# Local development (.env.local):
VITE_PB_URL=http://127.0.0.1:8090
#
# Production (.env.production) — the Cloudflare-tunneled PocketBase:
# VITE_PB_URL=https://api.scriviapayroll.com
#
# Never default this to the local dev PocketBase URL in production code — a
# public page must talk to https://api.scriviapayroll.com (see pb.ts).
